{
  "expo": {
    "name": "Punch List",
    "slug": "punch-list",
    "owner": "jakeross",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "punchlist",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.rossbuilt.punchlist",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2830",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A2830",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Punch List uses the camera to take photos of items on the job.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Punch List uses your photos so you can add one to an item.",
          "cameraPermission": "Punch List uses the camera to take photos of items on the job.",
          "microphonePermission": "Punch List uses the microphone when you say what is left to do, to write it down as items."
        }
      ],
      "expo-asset",
      "expo-mail-composer",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Punch List uses the microphone when you say what is left to do, to write it down as items.",
          "speechRecognitionPermission": "Punch List turns what you say into items on the job.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1A2830"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "037db08a-8ab6-4f77-8840-8c82789b503b"
      }
    }
  }
}
