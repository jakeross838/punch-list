{
  "name": "punch-list",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:extension": "node apps/extension/build.mjs",
    "test:extension": "node apps/extension/build.mjs && tsx tools/extension-e2e.ts",
    "phase0": "tsx tools/phase0.ts",
    "test:db": "bash tools/db-test.sh",
    "preview:build": "cd apps/mobile && npx expo export --platform web && cd ../.. && node tools/build-preview.mjs",
    "test:preview": "tsx tools/preview-e2e.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
