{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "chrome"
    ]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/*/src",
    "tools"
  ],
  "exclude": [
    "tools/extension-e2e.ts",
    "apps/mobile",
    "tools/preview-e2e.ts"
  ]
}
